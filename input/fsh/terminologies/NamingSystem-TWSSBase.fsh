Instance: TWSSBaseNamingSystemCaseNumber
InstanceOf: NamingSystem
Usage: #definition
* name = "TWSSCaseNumber"
* status = #active
* kind = #identifier
* date = "2026-08-09"
* publisher = "衛生福利部社會及家庭署"
* description = "TWSS 個案案件編號識別碼命名系統。"
* uniqueId[0].type = #uri
* uniqueId[0].value = "https://sfaa.gov.tw/base/identifier/case-number"
* uniqueId[0].preferred = true

