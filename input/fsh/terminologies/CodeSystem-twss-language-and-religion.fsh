* ^status = #active
* ^experimental = false
* http://terminology.hl7.org/CodeSystem/v3-ReligiousAffiliation#1029 "Mahayana"
* http://terminology.hl7.org/CodeSystem/v3-ReligiousAffiliation#1050 "Taoism"
